# CapCraft reads these from the environment. The app does not read a .env file by itself.
#   Locally:  export them in your shell before running uvicorn.
#   On Render: add them under Environment in the dashboard.
# Every one is optional. Each feature switches on only when its setting exists.

# SEC EDGAR asks every program to identify itself: a name and a contact email.
CAPCRAFT_SEC_USER_AGENT=Your Name you@example.com

# Alpha Vantage free key (latest share price)
ALPHAVANTAGE_API_KEY=

# FRED free key (10-year Treasury yield)
FRED_API_KEY=

# Only needed if the frontend is served from a different address
# CAPCRAFT_CORS=https://your-frontend.example.com
