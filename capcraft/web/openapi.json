   "DCFRequest": {
    "properties": {
     "base_revenue": {
      "type": "number",
      "maximum": 1000000000000.0,
      "exclusiveMinimum": 0.0,
      "title": "Base Revenue",
      "default": 1000
     },
     "revenue_growth": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       }
      ],
      "title": "Revenue Growth",
      "description": "One rate for every year, or one per forecast year",
      "default": 0.08
     },
     "years": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 15.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Years",
      "default": 5
     },
     "ebit_margin": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       }
      ],
      "title": "Ebit Margin",
      "default": 0.18
     },
     "tax_rate": {
      "type": "number",
      "exclusiveMaximum": 1.0,
      "minimum": 0.0,
      "title": "Tax Rate",
      "default": 0.25
     },
     "da_pct": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       }
      ],
      "title": "Da Pct",
      "default": 0.04
     },
     "capex_pct": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       }
      ],
      "title": "Capex Pct",
      "default": 0.05
     },
     "nwc_pct": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       }
      ],
      "title": "Nwc Pct",
      "default": 0.1
     },
     "discount_rate": {
      "type": "number",
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Discount Rate",
      "default": 0.09
     },
     "terminal_method": {
      "type": "string",
      "enum": [
       "gordon",
       "exit_multiple"
      ],
      "title": "Terminal Method",
      "default": "gordon"
     },
     "terminal_growth": {
      "anyOf": [
       {
        "type": "number",
        "exclusiveMaximum": 1.0,
        "minimum": -0.1
       },
       {
        "type": "null"
       }
      ],
      "title": "Terminal Growth",
      "default": 0.025
     },
     "exit_multiple": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 200.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Exit Multiple"
     },
     "net_debt": {
      "type": "number",
      "maximum": 1000000000000.0,
      "minimum": -1000000000000.0,
      "title": "Net Debt",
      "default": 0.0
     },
     "shares_outstanding": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 1000000000000.0,
        "exclusiveMinimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Shares Outstanding"
     },
     "mid_year": {
      "type": "boolean",
      "title": "Mid Year",
      "default": false
     },
     "market_price": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 1000000000.0,
        "exclusiveMinimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Market Price",
      "description": "Per-share market price, for the reverse DCF"
     }
    },
    "type": "object",
    "title": "DCFRequest"
   },
