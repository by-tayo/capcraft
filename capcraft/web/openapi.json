      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Annual Return",
      "description": "Compound growth per year (CAGR)"
     },
     "annual_risk": {
      "type": "number",
      "title": "Annual Risk"
     },
     "sharpe": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sharpe"
     },
     "max_drawdown": {
      "type": "number",
      "title": "Max Drawdown"
     },
     "beta": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Beta"
     },
     "own_risk_share": {
      "type": "number",
      "title": "Own Risk Share",
      "description": "Share of the portfolio's risk this holding adds"
     }
    },
    "type": "object",
    "required": [
     "name",
     "weight",
     "annual_return",
     "annual_risk",
     "sharpe",
     "max_drawdown",
     "beta",
     "own_risk_share"
    ],
    "title": "AssetRow"
   },
   "Capabilities": {
    "properties": {
     "company": {
      "type": "boolean",
      "title": "Company",
      "description": "Real companies can be loaded, live or from saved snapshots"
     },
     "live_company": {
      "type": "boolean",
      "title": "Live Company",
      "description": "SEC filings loader is configured for live lookups"
     },
     "saved_companies": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Saved Companies",
      "description": "Tickers available from saved snapshots"
     },
     "price": {
      "type": "boolean",
      "title": "Price",
      "description": "Share price lookup is configured"
     },
     "rates": {
      "type": "boolean",
      "title": "Rates",
      "description": "Treasury yield lookup is configured"
     }
    },
    "type": "object",
    "required": [
     "company",
     "live_company",
     "saved_companies",
     "price",
     "rates"
    ],
    "title": "Capabilities"
   },
